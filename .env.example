# Copy these into Vercel: Project -> Settings -> Environment Variables.
# Never commit a real .env file.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
JWT_SECRET=a-long-random-string-at-least-32-characters

# Password reset by email (optional). Works with any SMTP account.
# Gmail: turn on 2-step verification, then create an "App password" and use it as SMTP_PASS.
SITE_URL=https://your-site.vercel.app
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-letter-app-password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM=Study Flight <you@gmail.com>
